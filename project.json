{
	"name": "cppkg",
	"version": "0.0.1",
	"type": "executable",
	"binName": "cppkg",
	"source": [
		"main.cpp",
		"project.cpp",
		"depMan.cpp",
		"builder.cpp",
		"paths.cpp",
		"json.cpp"
	],
	"compileFlags": ["-std=c++20"],
	"linkFlags": ["-lcurl"],
	"debug": {
		"compileFlags": ["-g", "-Wall"]
	},
	"release": {
		"compileFlags": ["-O2"]
	},
	"customCommands": {
		"install": "cp cppkg /usr/local/bin"
	}
}
