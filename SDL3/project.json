{
	"name": "SDL3",
	"version": "3.4.20",
	"type": "library",
	"binName": "libSDL3",
	"source": [],
	"compileFlags": [],
	"linkFlags": [],
	"debug": {
		"compileFlags": ["-g", "-Wall"],
		"externalBuildCommand": [
			"mkdir SDL/build;",
			"cd SDL/build;cmake .. -DCMAKE_BUILD_TYPE=Debug -DSDL_SHARED=ON -DSDL_STATIC=ON",
			"cd SDL/build;make -j16"
		]
	},
	"release": {
		"compileFlags": ["-O2"]
	},
	"prebuildCommands":[
		"curl -LO https://github.com/libsdl-org/SDL/releases/download/release-3.4.20/SDL3-3.4.20.tar.gz",
		"tar -xzvf SDL3-3.4.20.tar.gz",
		"mv SDL3-3.4.20 SDL"
	],
	"externalBuildCommand": [
		"mkdir SDL/build",
		"cd SDL/build;cmake .. -DSDL_SHARED=ON -DSDL_STATIC=ON",
		"cd SDL/build;make -j16"
	],
	"win-x86_64":{
		"externalBuildCommand": [
			"mkdir SDL/build",
			"cd SDL/build;x86_64-w64-mingw32-cmake .. -DSDL_SHARED=ON -DSDL_STATIC=ON",
			"cd SDL/build;make -j16"
		],
		"debug":{
			"externalBuildCommand": [
				"mkdir SDL/build",
				"cd SDL/build;x86_64-w64-mingw32-cmake .. -DCMAKE_BUILD_TYPE=Debug -DSDL_SHARED=ON -DSDL_STATIC=ON",
				"cd SDL/build;make -j16"
			]
		},
		"linkFlags": ["-lwinmm", "-lole32", "-lhid", "-lsetupapi", "-lkernel32", "-luser32", "-lgdi32", "-limm32", "-loleaut32", "-lversion", "-luuid", "-ladvapi32", "-lshell32"]
	},
	"postbuildCommands":[
		"cp SDL/build/libSDL3.so .",
		"patchelf --set-soname libSDL3.so libSDL3.so",
		"cp SDL/build/libSDL3.a .",
		"cp SDL/build/SDL3.dll .",
		"cp SDL/build/libSDL3.lib .",
		"rm -rf -f include",
		"cp -r SDL/include .",
		"rm -rf -f SDL/build",
		"rm -rf -f SDL",
		"rm -f *.tar.gz"
	],
	"extraCleanCommands":[
		"rm -rf -f include",
		"rm -f *.dll *.lib *.a"
	]
}
