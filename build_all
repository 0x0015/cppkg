#!/bin/sh
exec clang-repl --Xcc=-std=c++20 "$(tail -n +3 "$0")"

#include <iostream>
#include <filesystem>

auto cwd = std::filesystem::current_path();
for(const auto& dir_entry : std::filesystem::directory_iterator{cwd}){
	if(dir_entry.is_directory()){
		auto projPath = dir_entry.path();
		if(projPath.filename().string()[0] == '.')
			continue;
		std::filesystem::current_path(projPath);
		std::cout<<"Cleaning project: "<<projPath.filename().string()<<std::endl;
		system("cppkg clean");
		std::cout<<"Building project: "<<projPath.filename().string()<<std::endl;
		if(system("cppkg build release") != 0){
			std::cerr<<"Build failed"<<std::endl;
			break;
		}
		std::cout<<"Packaging project: "<<projPath.filename().string()<<std::endl;
		system("cppkg package");
		std::cout<<"Cleaning project (again): "<<projPath.filename().string()<<std::endl;
		system("cppkg clean");
	}
}

