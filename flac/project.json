{
	"name": "flac",
	"version": "1.5.0",
	"type": "library",
	"binName": "libFLAC",
	"source": [],
	"compileFlags": [],
	"linkFlags": [],
	"deps": ["ogg"],
	"debug": {
		"compileFlags": ["-g", "-Wall"],
		"externalBuildCommand": [
			"mkdir flac/build;",
			"cd flac/build;cmake .. -DCMAKE_BUILD_TYPE=Debug",
			"cd flac/build;make -j16",
			"cp flac/build/src/libFLAC/libFLAC.a .",
			"rm -rf flac/build;mkdir flac/build",
			"cd flac/build;cmake .. -DCMAKE_BUILD_TYPE=Debug -DBUILD_SHARED_LIBS=ON",
			"cd flac/build;make -j16",
			"cp flac/build/src/libFLAC/libFLAC.so .",
			"patchelf --set-soname libFLAC.so libFLAC.so",
			"patchelf --replace-needed libogg.so.0 libogg.so libFLAC.so"
		]
	},
	"release": {
		"compileFlags": ["-O2"]
	},
	"prebuildCommands":[
		"curl -LO https://github.com/xiph/flac/releases/download/1.5.0/flac-1.5.0.tar.xz",
		"tar -xvf flac-1.5.0.tar.xz",
		"mv flac-1.5.0 flac",
		"curl -LO https://github.com/xiph/ogg/releases/download/v1.3.6/libogg-1.3.6.tar.xz",
		"tar -xvf libogg-1.3.6.tar.xz",
		"mv libogg-1.3.6 flac/ogg"
	],
	"externalBuildCommand": [
		"mkdir flac/build",
		"cd flac/build;cmake ..",
		"cd flac/build;make -j16",
		"cp flac/build/src/libFLAC/libFLAC.a .",
		"rm -rf flac/build;mkdir flac/build",
		"cd flac/build;cmake .. -DBUILD_SHARED_LIBS=ON",
		"cd flac/build;make -j16",
		"cp flac/build/src/libFLAC/libFLAC.so .",
		"patchelf --set-soname libFLAC.so libFLAC.so",
		"patchelf --replace-needed libogg.so.0 libogg.so libFLAC.so"
	],
	"win-x86_64":{
		"externalBuildCommand": [
			"mkdir flac/build",
			"cd flac/build;x86_64-w64-mingw32-cmake ..",
			"cd flac/build;make -j16",
			"cp flac/build/objs/libFLAC.dll .",
			"rm -rf flac/build;mkdir flac/build",
			"cd flac/build;x86_64-w64-mingw32-cmake .. -DBUILD_SHARED_LIBS=OFF",
			"cd flac/build;make -j16",
			"cp flac/build/src/libFLAC/libFLAC.a ."
		],
		"debug":{
			"externalBuildCommand": [
				"mkdir flac/build",
				"cd flac/build;x86_64-w64-mingw32-cmake .. -DCMAKE_BUILD_TYPE=Debug",
				"cd flac/build;make -j16",
				"cp flac/build/objs/libFLAC.dll .",
				"rm -rf flac/build;mkdir flac/build",
				"cd flac/build;x86_64-w64-mingw32-cmake .. -DCMAKE_BUILD_TYPE=Debug -DBUILD_SHARED_LIBS=OFF",
				"cd flac/build;make -j16",
				"cp flac/build/src/libFLAC/libFLAC.a ."
			]
		},
		"linkFlags": []
	},
	"postbuildCommands":[
		"rm -rf -f include",
		"mkdir include",
		"cp -r flac/include/FLAC include",
		"rm -rf -f flac",
		"rm -f flac-1.5.0.tar.xz libogg-1.3.6.tar.xz"
	],
	"extraCleanCommands":[
		"rm -rf -f include",
		"rm -f *.dll *.lib *.a"
	]
}
